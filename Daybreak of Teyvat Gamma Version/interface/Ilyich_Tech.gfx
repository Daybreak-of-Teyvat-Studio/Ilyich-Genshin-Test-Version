# ====================
# 提瓦特黎明 Gamma Version
# 耕地机 / 死兆星号 装备图标补丁
#
# HOI4 的装备图标不是按文件名自动加载的，必须在 interface/*.gfx 里
# 定义 sprite，名字固定为 GFX_<装备ID>_medium。
# 本文件只补 Gamma 版缺失的 4 条装备图标，不改动任何既有文件。
# 纹理全部复用 MOD 内已有的 gfx/interface/technologies/DOT_Ruin/ 资源。
# ====================
spriteTypes = {

	# 耕地机（原型）
	spriteType = {
		name = "GFX_Ruin_Giant_equipment_medium"
		texturefile = "gfx/interface/technologies/DOT_Ruin/DOT_Ruin.dds"
	}
	# 耕地机（赤月型·1936）
	spriteType = {
		name = "GFX_Ruin_Giant_equipment_1_medium"
		texturefile = "gfx/interface/technologies/DOT_Ruin/DOT_Ruin_02.dds"
	}

	# 死兆星号（原型）
	spriteType = {
		name = "GFX_Ilyich_Sizhaoxing_medium"
		texturefile = "gfx/interface/technologies/DOT_Ruin/Ilyich_Sizhaoxing.png"
	}
	# 死兆星号（试做型）
	spriteType = {
		name = "GFX_Ilyich_Sizhaoxing_1_medium"
		texturefile = "gfx/interface/technologies/DOT_Ruin/Ilyich_Sizhaoxing.png"
	}

}
